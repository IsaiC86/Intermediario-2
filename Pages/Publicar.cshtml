@page
@model intermediarioDB.Pages.PublicarModel
@{
    ViewData["Title"] = "Publicar producto";
}

<h1>Publicar producto</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}

@if (!Model.Verificado)
{
    <div class="alert alert-warning">
        Tu cuenta está en estado <strong>@Model.EstadoVerificacion</strong>.
        Solo los usuarios verificados pueden publicar productos.
    </div>
}

@if (Model.Verificado)
{
    <form method="post" enctype="multipart/form-data" style="max-width:480px">
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Foto" class="form-label"></label>
            <input asp-for="Foto" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Publicar</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}